# From @BotFather in Telegram. Leave empty to run the website only.
TELEGRAM_BOT_TOKEN=
# Where users, the forecast log and snapshots are kept. On Railway, mount a volume here.
DATA_DIR=./data
# Web server port (Railway sets this for you)
PORT=3000
# Minutes between venue data refreshes, and between alert checks
REFRESH_MIN=60
ALERT_MIN=10
